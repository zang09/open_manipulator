<?xml version="1.0"?>
<robot name="omy_f3m_d435" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="prefix" default="" />
  <xacro:arg name="use_sim" default="false" />
  <xacro:arg name="use_mock_hardware" default="false" />
  <xacro:arg name="mock_sensor_commands" default="false" />
  <xacro:arg name="config_type" default="omy_f3m_d435" />
  <xacro:arg name="ros2_control_type" default="omy_f3m_d435_position" />

  <xacro:include filename="$(find open_manipulator_description)/urdf/omy_f3m_d435/omy_f3m_d435_arm.urdf.xacro" />

  <xacro:include filename="$(find open_manipulator_description)/gazebo/omy_f3m_d435.gazebo.xacro" />

  <xacro:include filename="$(find open_manipulator_description)/urdf/omy_f3m_d435/rh_p12_rn_a.urdf.xacro" />

  <xacro:include filename="$(find open_manipulator_description)/gazebo/rh_p12_rn_a.gazebo.xacro" />

  <xacro:include filename="$(find open_manipulator_description)/ros2_control/$(arg ros2_control_type).ros2_control.xacro" />

  <xacro:include filename="$(find open_manipulator_description)/ros2_control/omy_f3m_d435_end_unit.ros2_control.xacro" />

  <link name="world"/>

  <joint name="$(arg prefix)world_fixed" type="fixed">
    <parent link="world"/>
    <child link="$(arg prefix)link0"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="$(arg prefix)gripper_fixed" type="fixed">
    <origin xyz="0 -0.006 0" rpy="1.57 -1.57 0"/>
    <parent link="$(arg prefix)end_effector_flange_link"/>
    <axis xyz="0 0 0"/>
    <child link="$(arg prefix)rh_p12_rn_base"/>
  </joint>

  <joint name="$(arg prefix)end_effector_joint" type="fixed">
    <parent link="$(arg prefix)end_effector_flange_link"/>
    <child link="$(arg prefix)end_effector_link"/>
    <origin xyz="0 -0.141 0" rpy="0 0 0"/>
  </joint>

  <link name="$(arg prefix)end_effector_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.01 0.01" />
      </geometry>
      <material name="red">
        <color rgba="1.0 0.0 0.0 1"/>
      </material>
    </visual>
  </link>

  <!-- Mount box under the base. The robot stands on an empty 230 x 230 x 115 mm box,
       centred on link0's axis; the box's top face IS link0's mounting plane, so it
       fills z = -0.115 .. 0 in link0 and the surface it stands on is 115 mm below
       link0. Mass is nominal - the link is fixed to the base and never enters arm
       dynamics, and the inertial is here only so the box is a body rather than a
       bare frame (box inertia for 1 kg at 0.23 x 0.23 x 0.115).

       NO COLON-SPACE ANYWHERE IN THIS FILE, comments included. ros2 launch infers a
       parameter's type by running yaml.safe_load over its value, and this whole URDF
       reaches robot_description as one string. It survives that only by parsing as a
       plain YAML scalar, which a colon followed by a space ends - YAML then reads it as a mapping key
       and the
       launch dies with "Unable to parse the value of parameter robot_description as
       yaml". Measured 2026-08-18 - one such colon in a comment here was enough. The real
       fix is ParameterValue(value_type=str) at every robot_description in
       open_manipulator_bringup and _description launch files, and until those carry
       it this file has to stay YAML-safe. -->
  <joint name="$(arg prefix)base_box_joint" type="fixed">
    <parent link="$(arg prefix)link0"/>
    <child link="$(arg prefix)base_box_link"/>
    <origin xyz="0 0 -0.0575" rpy="0 0 0"/>
  </joint>

  <link name="$(arg prefix)base_box_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.23 0.23 0.115"/>
      </geometry>
      <material name="cardboard">
        <color rgba="0.76 0.60 0.42 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.23 0.23 0.115"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="5.510417e-03" ixy="0.0" ixz="0.0" iyy="5.510417e-03" iyz="0.0" izz="8.816667e-03"/>
    </inertial>
  </link>

  <xacro:omy_f3m_d435 prefix="$(arg prefix)" />
  <xacro:omy_f3m_d435_gazebo prefix="$(arg prefix)" />
  <xacro:rh_p12_rn_a prefix="$(arg prefix)" />
  <xacro:rh_p12_rn_a_gazebo prefix="$(arg prefix)" />

  <xacro:omy_f3m_d435_system
    name="OMYF3MSystem" prefix="$(arg prefix)" use_sim="$(arg use_sim)"
    use_mock_hardware="$(arg use_mock_hardware)"
    mock_sensor_commands="$(arg mock_sensor_commands)"/>

  <xacro:omy_f3m_d435_end_unit_system
    name="OMYF3MEndUnitSystem" prefix="$(arg prefix)" use_sim="$(arg use_sim)"
    use_mock_hardware="$(arg use_mock_hardware)"
    mock_sensor_commands="$(arg mock_sensor_commands)"/>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find open_manipulator_bringup)/config/$(arg config_type)/hardware_controller_manager.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
